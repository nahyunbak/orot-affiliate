{
  "name": "template-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nest build",
    "start:dev": "nest start --watch ",
    "type-check": "tsc --noEmit",
    "prisma-studio": "prisma studio",
    "prisma-migrate": "prisma migrate deploy",
    "run-docker": "docker compose --env-file .env up -d",
    "generate-types": "node ../scripts/copy-prisma-types.js && node ../scripts/generate-shared-types.js",
    "generate-controllers": "ts-node ../scripts/generate-controllers.ts",
    "generate-endpoint": "node ../scripts/generate-endpoint.js",
    "generate-hooks": "node ../scripts/generate-hooks.js",
    "generate-utils": "node ../scripts/copy-backend-utils.js",
    "generate-api": "node ../scripts/generate-api.js",
    "format-sql": "prettier --write 'prisma/*.sql'",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "node --test tests/*.test.cjs && node -r ts-node/register/transpile-only -r tsconfig-paths/register --test src/auth/developer-login.test.ts src/common/interceptors/sentry.interceptor.test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "generate-api:mobile": "node ../scripts/generate-api.js --target mobile",
    "generate-api:web": "node ../scripts/generate-api.js --target web",
    "generate-api:all": "node ../scripts/generate-api.js --target both",
    "pg-reset": "dotenv -e .env.dev prisma migrate reset",
    "prisma-reset": "prisma migrate reset",
    "test:affiliate": "node --require ts-node/register --test test/affiliate.test.cjs",
    "setup:testnet": "ts-node scripts/setup-testnet.ts",
    "verify:testnet": "node scripts/verify-testnet.cjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.4.13",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^8.0.7",
    "@prisma/client": "6.13.0",
    "@sentry/nestjs": "^10.47.0",
    "apple-signin-auth": "^2.0.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.5.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@sqltools/formatter": "^1.2.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prettier-plugin-sql": "^0.19.2",
    "prisma": "6.13.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "packageManager": "pnpm@10.13.1"
}
