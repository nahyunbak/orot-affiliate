# 루트 개발 도구용 설정. 각 앱의 .env.example도 별도로 복사한다.
# EXPO_PUBLIC_/NEXT_PUBLIC_ 값은 앱에 포함된다. 비밀 키를 넣지 않는다.
BUNDLE_ID=com.orot.affiliate
APP_SCHEME=orotaffiliate

# 선택: App Store Connect / 메타데이터 업로드
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY_PATH=
APP_BUNDLE_ID=com.orot.affiliate
TERMS_OF_SERVICE_URL=
PRIVACY_POLICY_URL=
SUPPORT_URL=
MARKETING_URL=
DEVELOPER_EMAIL=

# 선택: Figma 스크린샷 작업
FIGMA_DESIGN_URL=
FIGMA_FILE_KEY=
FIGMA_NODE_ID=
IMAGE_URL=

# 선택: Sentry → GitHub 이슈 동기화 (Actions에서는 secrets/variables로 설정)
SENTRY_ORG=
SENTRY_PROJECTS=
SENTRY_AUTH_TOKEN=
